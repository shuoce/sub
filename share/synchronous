mixed-port: 7890
allow-lan: true
mode: rule
log-level: info

ipv6: true
unified-delay: true
tcp-concurrent: true

profile:
  store-selected: true
  store-fake-ip: true

# =========================
# 节点订阅
# =========================
proxy-providers:

  峰:
    type: http
    url: "https://shuoce1.eu.cc/share/a.txt"
    path: ./providers/feng.yaml
    interval: 3600
    lazy: true

    health-check:
      enable: true
      interval: 300
      url: "http://www.gstatic.com/generate_204"


# =========================
# 节点分组
# =========================
proxy-groups:

  # 总节点选择
  - name: 🚀节点选择
    type: select
    proxies:
      - ⚡自动优选
      - 🎯手动选择
      - 🇭🇰香港
      - 🇹🇼台湾
      - 🇯🇵日本
      - 🇰🇷韩国
      - 🇸🇬新加坡
      - 🇺🇸美国
      - 🇬🇧英国
      - 🇨🇦加拿大
      - 🇦🇺澳大利亚
      - 🇩🇪德国
      - 🇫🇷法国
      - 🇳🇱荷兰
      - DIRECT


  # 手动选择全部节点
  - name: 🎯手动选择
    type: select
    use:
      - 峰


  # 自动测速选择最快节点
  - name: ⚡自动优选
    type: url-test
    use:
      - 峰
    url: "http://www.gstatic.com/generate_204"
    interval: 300
    tolerance: 50
    lazy: true


  # =========================
  # 香港
  # =========================
  - name: 🇭🇰香港
    type: url-test
    use:
      - 峰
    filter: "(?i)香港|HK|🇭🇰"
    url: "http://www.gstatic.com/generate_204"
    interval: 300
    tolerance: 50


  # =========================
  # 台湾
