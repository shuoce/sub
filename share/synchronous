mixed-port: 7890
allow-lan: true
mode: rule
log-level: info

# IPv6 网络稳定且代理节点支持 IPv6 时保持 true；
# 如果出现 IPv6 直连或访问异常，改为 false
ipv6: true

unified-delay: true
tcp-concurrent: true
keep-alive-interval: 30

# Geo 数据设置
geodata-mode: true
geo-auto-update: true
geo-update-interval: 24

profile:
  store-selected: true
  store-fake-ip: true

# =========================
# DNS 配置
# =========================
dns:
  enable: true
  ipv6: true
  listen: 0.0.0.0:1053

  # fake-ip 可以减少 DNS 污染和泄漏
  enhanced-mode: fake-ip
  fake-ip-range: 198.18.0.1/16

  # 默认 DNS，用于解析 DNS 服务器域名和节点域名
  default-nameserver:
    - 223.5.5.5
    - 119.29.29.29
    - 1.1.1.1

  # 常规 DNS
  nameserver:
    - https://dns.alidns.com/dns-query
    - https://doh.pub/dns-query
    - https://223.5.5.5/dns-query

  # 节点域名解析使用，避免节点域名解析失败
  proxy-server-nameserver:
    - 223.5.5.5
    - 119.29.29.29
    - 1.1.1.1

  # 局域网、本地域名和系统检测域名不使用 fake-ip
  fake-ip-filter:
    - "*.lan"
    - "*.local"
    - "*.home.arpa"
    - "+.router"
    - "+.miwifi.com"
    - "+.tplinkwifi.net"
    - "+.asusrouter.com"
    - "+.msftconnecttest.com"
    - "+.msftncsi.com"
    - "+.market.xiaomi.com"
    - "+.pool.ntp.org"
    - "+.ntp.org"
    - "+.time.apple.com"
    - "+.time.windows.com"
    - "localhost.ptlogin2.qq.com"
    - "localhost.sec.qq.com"

# =========================
# 节点订阅
# =========================
proxy-providers:
  峰:
    type: http
    url: "https://shuoce1.eu.cc/share/a.txt"
    path: ./providers/feng.yaml
    interval: 3600
    lazy: true

    # 订阅更新及节点测速
    health-check:
      enable: true
      interval: 300
      url: "https://www.gstatic.com/generate_204"

# =========================
# 节点分组
# =========================
proxy-groups:

  # 总节点选择
  - name: 🚀节点选择
    type: select
    proxies:
      - ⚡自动优选
      - 🎯手动选择
      - 🇭🇰香港
      - 🇹🇼台湾
      - 🇯🇵日本
      - 🇰🇷韩国
      - 🇸🇬新加坡
      - 🇺🇸美国
      - 🇬🇧英国
      - 🇨🇦加拿大
      - 🇦🇺澳大利亚
      - 🇩🇪德国
      - 🇫🇷法国
      - 🇳🇱荷兰
      - DIRECT

  # 手动选择全部节点
  - name: 🎯手动选择
    type: select
    use:
      - 峰
    proxies:
      - DIRECT

  # 自动选择延迟最低节点
  # 不加入 DIRECT，避免直连延迟最低导致自动优选失效
  - name: ⚡自动优选
    type: url-test
    use:
      - 峰
    url: "https://www.gstatic.com/generate_204"
    interval: 300
    tolerance: 50
    lazy: true

  # =========================
  # 香港
  # =========================
  - name: 🇭🇰香港
    type: url-test
    use:
      - 峰
    filter: '(?i)(香港|Hong ?Kong|HK[ -]?\d*|🇭🇰)'
    url: "https://www.gstatic.com/generate_204"
    interval: 300
    tolerance: 50
    lazy: true

